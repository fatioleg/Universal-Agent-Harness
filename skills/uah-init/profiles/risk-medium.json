    },
    {
      "id": "H1M-rewrite",
      "pattern": "\\bgit\\s+(rebase|filter-branch|filter-repo)\\b",
      "reason": "reescrita de histórico"
    }
  ],
  "settings": {
    "allow": [],
    "ask": [],
    "deny": []
  },
  "plan_gate": true,
  "g4_checkpoint": "off",
  "max_attempts": 3
}
